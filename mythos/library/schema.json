{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"MYTHOS Digital Transcript",
  "type":"object",
  "required":["id","title","kind","era","status","summary","provenance","claims","evidence","sources"],
  "properties":{
    "id":{"type":"string"},
    "title":{"type":"string"},
    "kind":{"type":"string"},
    "era":{"type":"string"},
    "culture":{"type":"string"},
    "region":{"type":"string"},
    "date_start":{"type":["string","null"]},
    "date_end":{"type":["string","null"]},
    "status":{"type":"string"},
    "confidence":{"type":"number","minimum":0,"maximum":1},
    "summary":{"type":"string"},
    "provenance":{"type":"object"},
    "claims":{"type":"array","items":{"type":"object"}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "counterevidence":{"type":"array","items":{"type":"object"}},
    "interpretations":{"type":"array","items":{"type":"object"}},
    "relationships":{"type":"array","items":{"type":"object"}},
    "sources":{"type":"array","items":{"type":"object"}},
    "revision":{"type":"object"}
  }
}