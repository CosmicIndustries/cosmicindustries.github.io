{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Atlas Arrival Prediction",
  "type":"object",
  "required":["id","arrival_class","target","arrival_condition","state_epoch","reference_frame","time_scale","status"],
  "properties":{
    "id":{"type":"string"},
    "arrival_class":{"enum":["OBSERVED_TRACK","PREDICTED_NATURAL","SCHEDULED_HUMAN","HYPOTHETICAL","SEARCH_TARGET","SPECULATIVE"]},
    "target":{"type":"object"},
    "origin":{"type":"object"},
    "state_epoch":{"type":"string"},
    "reference_frame":{"type":"string"},
    "time_scale":{"type":"string"},
    "arrival_condition":{"type":"string"},
    "window":{"type":"object","properties":{
      "earliest":{"type":"string"},
      "central":{"type":"string"},
      "latest":{"type":"string"},
      "confidence":{"type":"number","minimum":0,"maximum":1}
    }},
    "model":{"type":"object"},
    "uncertainty":{"type":"object"},
    "evidence":{"type":"array","items":{"type":"string"}},
    "status":{"type":"string"},
    "relationships":{"type":"array","items":{"type":"object"}}
  }
}