{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cosmicindustries.github.io/scientific-atlas/schema/you-are-here.schema.json",
  "title":"Fort Knowledge YOU ARE HERE registry",
  "type":"object",
  "required":["schema_version","snapshot","anchor_classes","current","exact_bootstrap","reference_variants","you_are_here_requires"],
  "properties":{
    "schema_version":{"type":"string"},
    "snapshot":{"type":"string","format":"date"},
    "anchor_classes":{"type":"array","items":{"type":"string"}},
    "current":{"type":"object"},
    "exact_bootstrap":{"type":"array","items":{"type":"object","required":["id","symbol","value","unit","class"],"properties":{"id":{"type":"string"},"symbol":{"type":"string"},"value":{"type":"number"},"unit":{"type":"string"},"class":{"type":"string"}}}},
    "reference_variants":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
    "you_are_here_requires":{"type":"array","items":{"type":"string"}}
  }
}
